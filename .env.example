# ============================================================================
# VARIÁVEIS DE AMBIENTE - Censo CEEP com PentaIA Integration
# ============================================================================

# ===== VITE CONFIG =====
VITE_APP_ENV=development
VITE_PENTAIA_API_URL=/api
VITE_PENTAIA_MOCK_MODE=false

# ===== SUPABASE CONFIG =====
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# ===== APLICAÇÃO CENSO CEEP =====
VITE_APP_TITLE=Censo CEEP - Pesquisa Participativa de Equidade Étnico-Racial
VITE_APP_VERSION=0.1.0

# ===== PENTAIA SERVIÇOS =====
VITE_ZIOS_ENDPOINT=/api/v1/zios/chat
VITE_HEIMDALL_ENDPOINT=/api/v1/heimdall/auth
VITE_TAS_ENDPOINT=/api/v1/tas/search
VITE_IRIS_ENDPOINT=/api/v1/iris/analysis
VITE_MERCURY_ENDPOINT=wss://seu-dominio.com/ws/mercury

# ===== DEBUG =====
VITE_DEBUG=true

# ============================================================================
# INSTRUÇÕES DE USO
# ============================================================================
#
# 1. Copie este arquivo para .env.local:
#    cp .env.example .env.local
#
# 2. Preencha os valores com suas credenciais reais do Supabase e PentaIA.
#
# 3. No código, acesse via:
#    import.meta.env.VITE_SUPABASE_URL
#    import.meta.env.VITE_PENTAIA_API_URL
#
# 4. Variáveis com prefixo VITE_ são expostas ao frontend;
#    nunca adicione secretos aqui.
#
# ============================================================================
